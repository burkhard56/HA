alias: 00:05 Initialisierung
description: >-
  Hzg: Der Sollwert wird auf 21.5 Grad eingestellt und der Referenzraum ist das
  Erdgeschoss
triggers:
  - trigger: time
    at: "00:05:00"
conditions: []
actions:
  - action: input_number.set_value
    metadata: {}
    data:
      value: 21.5
    target:
      entity_id: input_number.heiz_temp_soll
  - action: input_select.select_option
    metadata: {}
    data:
      option: EG
    target:
      entity_id: input_select.heiz_referenzraum
mode: single
